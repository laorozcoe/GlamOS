# =============================================================================
# GlamOS - Variables de entorno
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA versiones el `.env`: contiene credenciales de base de datos.
# =============================================================================

# --- Base de datos (PostgreSQL / Neon) -------------------------------------
# Cadena con pooling, la que usa Prisma en runtime.
DATABASE_URL="postgres://USUARIO:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Cadena directa sin pooling, requerida por `prisma migrate`.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Variables que genera la integracion de Neon/Vercel.
# Solo son necesarias si algun script las consume directamente.
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# --- Autenticacion (Better Auth) -------------------------------------------
# URL base de la app. En local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"
# Secreto con el que se firman las cookies de sesion.
# OBLIGATORIO en produccion. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Multi-tenancy ---------------------------------------------------------
# Slug del negocio que se usa en desarrollo cuando el host es `localhost`
# y no se envia la cabecera `x-business-slug`.
DEV_BUSINESS_SLUG="testsalon"

# --- MercadoPago -----------------------------------------------------------
# `true` simula los cobros con terminal Point sin llamar a la API real.
# Debe quedar en `false` (o sin definir) en produccion.
MP_SIMULATE=false

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
