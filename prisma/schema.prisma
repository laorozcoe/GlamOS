// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// 🏢 NEGOCIO
//////////////////////

model Business {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  phone       String?
  countryCode String   @default("MX") @db.VarChar(2)
  email       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  clients           Client[]
  employees         Employee[]
  services          Service[]
  appointments      Appointment[]
  sales             Sale[] // La Venta es ahora el eje principal
  cashCloses        CashClose[] // Cortes de caja para auditoría
  payments          Payment[]
  reviews           Review[]
  loyaltyPoints     LoyaltyPoint[]
  serviceCategories ServiceCategory[]
  serviceExtras     ServiceExtra[]
  attendances       Attendance[]
  terminals         PaymentTerminal[]

  openHour          Int      @default(9)
  closeHour         Int      @default(18)
  weekStartDay      Int      @default(1) // 0 = Domingo, 1 = Lunes, etc.
  /// Minutos de gracia antes de que una entrada cuente como retardo.
  lateToleranceMinutes Int   @default(10)
  /// Si al guardar una cita se pregunta por el anticipo.
  askDepositOnBooking  Boolean @default(false)
  themeColors       Json?    // CSS custom property overrides: { "--color-brand-500": "#66bb6a", ... }

  // 💳 Configuración Mercado Pago
  mpAccessToken String?
  mpPublicKey   String?
  mpStoreId     String?
  mpWebhookSecret String? // Clave secreta para validar la firma de los webhooks de MP
  mpAccounts    Json?     // Array de tokens adicionales [{ id, name, accessToken, storeId }]

  coupons           Coupon[]
  promotions        Promotion[]
  productCategories ProductCategory[]
  products          Product[]
  bonusRules        BonusRule[]
  bonusAwards       BonusAward[]
  payrollPeriods    PayrollPeriod[]
}

//////////////////////
// 💳 TERMINALES MERCADO PAGO
//////////////////////

model PaymentTerminal {
  id          String   @id @default(uuid())
  businessId  String
  name        String   // Ej: "Caja Principal", "Barra"
  posId       String   // ID en Mercado Pago
  mpAccessToken String? // Token específico de esta terminal (si es de otra cuenta)
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id])
  payments    Payment[]

  @@index([businessId, active])
}

//////////////////////
// 👤 USUARIOS
//////////////////////

/// La identidad de una persona, independiente del salon.
///
/// Ya no lleva businessId ni role: la pertenencia a un salon y el rol dentro
/// de el viven en Employee (la membresia). Asi una misma persona entra con un
/// solo correo a varios salones, con sueldo, horario y rol distintos en cada
/// uno, y sin mezclar historiales.
model User {
  id         String   @id @default(uuid())
  name       String
  username   String
  lastName   String
  /// Unico en todo el sistema: es la credencial de acceso. Nullable porque
  /// hay usuarios historicos sin correo; Postgres permite varios NULL en un
  /// indice unico.
  email      String?  @unique
  password   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Membresias: una fila por salon al que pertenece esta persona.
  memberships Employee[]

  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  sessions      Session[]
  accounts      Account[]
}

enum Role {
  ADMIN
  RECEPTION
  EMPLOYEE
}

//////////////////////
// 👥 EMPLEADOS
//////////////////////

/// La membresia de una persona en UN salon.
///
/// Una misma persona (User) puede tener varias filas aqui, una por salon, cada
/// una con su propio rol, sueldo, comision y horario. Por eso todo el dinero y
/// la agenda cuelgan de employeeId y no de userId: si alguien renuncia en un
/// salon y entra en otro, su historial de ventas y nomina se queda con la
/// membresia vieja y no se reescribe.
model Employee {
  id          String   @id @default(uuid())
  businessId  String
  userId      String
  phone       String?
  countryCode String   @default("MX") @db.VarChar(2)
  bio         String?
  commission  Float    @default(0.0)
  baseSalary  Float    @default(0.0)
  rating      Float    @default(0.0)
  canCreateAppointments Boolean @default(true)
  canViewClientData     Boolean @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  /// Rol DENTRO de este salon. Antes vivia en User, lo que impedia ser ADMIN
  /// en un salon y EMPLOYEE en otro.
  role        Role     @default(RECEPTION)

  /// Si aparece en la agenda y en los selectores de personal. Las membresias
  /// puramente administrativas (un dueno que no atiende) van en false.
  bookable    Boolean  @default(true)

  /// Si entra en la nomina: sueldo base, comisiones y bonos. Es independiente
  /// de `bookable`: hay quien atiende sin sueldo base y quien cobra sin
  /// aparecer en la agenda. Hasta la fase 6 los dos eran el mismo campo.
  inPayroll   Boolean  @default(true)

  business     Business      @relation(fields: [businessId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
  reviews      Review[]
  sales        Sale[]
  clients      Client[]
  serviceRequests AppointmentServiceRequest[]
  attendances  Attendance[]
  bonusAwards  BonusAward[] @relation("BonusAwardEmployee")
  bonusAwardsGranted BonusAward[] @relation("BonusAwardGrantedBy")
  payrollLines PayrollLine[]
  payrollPeriodsClosed PayrollPeriod[] @relation("PayrollClosedBy")
  
  /// Horario por dia: 7 entradas, el indice es el dia de la semana de
  /// JavaScript (0 = domingo). Cada una { trabaja, entrada, salida }.
  ///
  /// Sustituye a las cuatro columnas de abajo, que solo permitian un horario
  /// de lunes a viernes y otro de sabado, dejaban el domingo clavado en "no
  /// trabaja" y no tenian forma de expresar un dia de descanso -que es lo que
  /// evita que un dia libre cuente como falta-.
  workSchedule Json?

  /// @deprecated Las lee `horarioDelDia` solo como respaldo mientras haya
  /// membresias sin `workSchedule`. No escribir aqui.
  workScheduleStartWeekday String? @db.VarChar(5) // "09:00"
  workScheduleEndWeekday   String? @db.VarChar(5)
  workScheduleStartSaturday String? @db.VarChar(5)
  workScheduleEndSaturday   String? @db.VarChar(5)

  // Una persona puede estar en varios salones, pero una sola vez en cada uno.
  @@unique([businessId, userId])
  @@index([businessId, active])
}

//////////////////////
// 👥 CLIENTES
//////////////////////

model Client {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  phone       String?
  countryCode String   @default("MX") @db.VarChar(2)
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  employeeId  String?
  active      Boolean  @default(true) // <-- NUEVO

  business      Business       @relation(fields: [businessId], references: [id])
  employee      Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  reviews       Review[]
  loyaltyPoints LoyaltyPoint[]
  sales         Sale[]

  @@unique([businessId, phone])
}

//////////////////////
// 💅 CATEGORÍAS
//////////////////////

model ServiceCategory {
  id         String   @id @default(uuid())
  businessId String
  name       String // MANOS, PIES, CABELLO, DEPILACIÓN
  order      Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id])
  services Service[]

  @@index([businessId, active])
}

//////////////////////
// 🛍️ CATEGORÍAS DE PRODUCTOS
//////////////////////

model ProductCategory {
  id         String    @id @default(uuid())
  businessId String
  name       String    // Ropa, Joyería, Cabello
  order      Int?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  business Business  @relation(fields: [businessId], references: [id])
  products Product[]

  @@index([businessId, active])
}

//////////////////////
// 🛍️ PRODUCTOS
//////////////////////

model Product {
  id            String          @id @default(uuid())
  businessId    String
  categoryId    String
  name          String
  description   String?
  price         Float
  variablePrice Boolean         @default(false)
  stock         Int             @default(0)
  barcode       String?

  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  business      Business        @relation(fields: [businessId], references: [id])
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  saleItems     SaleItem[]

  @@index([businessId, active])
}

//////////////////////
// 💅 SERVICIOS
//////////////////////

model Service {
  id                String  @id @default(uuid())
  businessId        String
  categoryId        String
  name              String // Manicura, Pedicura, Ondas
  description       String?
  descriptionTicket String? @db.VarChar(15)
  duration          Int // minutos
  price             Float

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  appointmentServices AppointmentService[]
  variants            ServiceVariant[]
  saleItems           SaleItem[]
  serviceRequests     AppointmentServiceRequest[]
  promotionServices   PromotionService[]

  @@index([businessId, active])
}

//////////////////////
// 🎁 VARIANTES DE SERVICIO
//////////////////////

model ServiceVariant {
  id        String  @id @default(uuid())
  serviceId String
  name      String // Corto, Largo, Manos, Pies
  duration  Int // minutos
  price     Float
  active    Boolean @default(true)

  service Service @relation(fields: [serviceId], references: [id])
}

//////////////////////
// 🎁 ADICIONALES DE SERVICIO
//////////////////////

model ServiceExtra {
  id          String   @id @default(uuid())
  businessId  String
  name        String // Diseño por uña, Extralargo
  priceMin    Float?
  priceMax    Float?
  durationMin Int?
  durationMax Int?
  createdAt   DateTime @default(now())

  business          Business           @relation(fields: [businessId], references: [id])
  appointmentExtras AppointmentExtra[]
}

//////////////////////
// 📅 CITAS (Solo para gestión de tiempo)
//////////////////////

model Appointment {
  id            String            @id @default(uuid())
  businessId    String
  clientId      String?
  employeeId    String
  title         String
  start         DateTime
  end           DateTime
  allDay        Boolean           @default(false)
  status        AppointmentStatus @default(PENDING)
  notes         String?
  guestName     String?
  guestPhone    String?
  countryCode   String            @default("MX") @db.VarChar(2)
  createdAt     DateTime          @default(now())
  paymentStatus PaymentState      @default(UNPAID) // Estado general de la deuda
  totalAmount   Float             @default(0) // El costo total del servicio (ej. $1000)
  sale          Sale?
  active        Boolean           @default(true) // <-- NUEVO

  business Business             @relation(fields: [businessId], references: [id])
  employee Employee             @relation(fields: [employeeId], references: [id])
  client   Client?              @relation(fields: [clientId], references: [id])
  services AppointmentService[]
  serviceRequests AppointmentServiceRequest[]

  @@index([businessId, start])
  @@index([employeeId, start])
}

//////////////////////
// 🔗 CITA - SERVICIOS
//////////////////////

model AppointmentService {
  id                String             @id @default(uuid())
  appointmentId     String
  serviceId         String?
  price             Float
  appointment       Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service           Service?           @relation(fields: [serviceId], references: [id])
  appointmentExtras AppointmentExtra[]
}

enum PaymentState {
  UNPAID // No ha pagado nada
  PARTIALLY_PAID // Dio anticipo pero debe el resto
  PAID // Pagado al 100%
  REFUNDED // Se le devolvió el dinero
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

//////////////////////
// ⏱️ ASISTENCIA
//////////////////////

model Attendance {
  id          String   @id @default(uuid())
  businessId  String
  employeeId  String
  date        DateTime @db.Date 
  status      AttendanceStatus @default(PRESENT)
  checkInTime String?  @db.VarChar(5) // "09:15"
  checkOutTime String?  @db.VarChar(5) // "18:00"
  notes       String?

  /// De donde salio la hora. SCHEDULE = quedo el horario precargado y nadie
  /// la toco, MANUAL = alguien la escribio, CLOCK = la puso un checador.
  /// Distinguir SCHEDULE del resto es lo que impide que el bono de
  /// puntualidad de por buenos los dias que nadie capturo.
  source      AttendanceSource @default(SCHEDULE)
  /// Identificador que manda el checador: huella, tarjeta, numero de reloj.
  sourceRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)

  business    Business @relation(fields: [businessId], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@unique([businessId, employeeId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSource {
  SCHEDULE
  MANUAL
  CLOCK
}

//////////////////////
// 📝 SOLICITUDES DE CAMBIO DE CITA
//////////////////////

model AppointmentServiceRequest {
  id                  String   @id @default(uuid())
  appointmentId       String
  serviceId           String?
  appointmentServiceId String? // ID of the existing AppointmentService ifaction is REMOVE
  employeeRequesterId String
  action              RequestAction // ADD, REMOVE
  status              RequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  createdAt           DateTime @default(now())

  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service             Service?    @relation(fields: [serviceId], references: [id])
  employee            Employee    @relation(fields: [employeeRequesterId], references: [id])
}

enum RequestAction {
  ADD
  REMOVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

//////////////////////
// 🔗 CITA - ADICIONALES
//////////////////////

model AppointmentExtra {
  id                   String             @id @default(uuid())
  appointmentServiceId String
  extraId              String
  quantity             Int                @default(1) // uñas
  price                Float
  duration             Int
  appointmentService   AppointmentService @relation(fields: [appointmentServiceId], references: [id])
  extra                ServiceExtra       @relation(fields: [extraId], references: [id])
}

//////////////////////
// 💳 PAGOS Y CAJA
//////////////////////

model Payment {
  id             String        @id @default(uuid())
  saleId         String
  businessId     String
  amount         Float // Monto de este pago específico
  method         PaymentMethod // CASH, CARD, TRANSFER
  status         PaymentStatus @default(COMPLETED)
  active         Boolean       @default(true) // <-- NUEVO
  /// Anticipo, no pago final. Distingue los dos pagos de una misma venta
  /// cuando ya se cobro el resto.
  isDeposit      Boolean       @default(false)
  // Datos para el ticket y auditoría
  amountReceived Float? // Útil para calcular el cambio en efectivo
  changeReturned Float?

  createdAt DateTime @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  terminalId String?
  terminal   PaymentTerminal? @relation(fields: [terminalId], references: [id])

  @@index([businessId, createdAt])
  @@index([saleId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

//////////////////////
// ⭐ RESEÑAS
//////////////////////

model Review {
  id         String   @id @default(uuid())
  businessId String
  clientId   String
  employeeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  active     Boolean  @default(true) // <-- NUEVO

  business Business @relation(fields: [businessId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

//////////////////////
// 🎁 PUNTOS DE LEALTAD
//////////////////////

model LoyaltyPoint {
  id         String   @id @default(uuid())
  businessId String
  clientId   String
  points     Int      @default(0)
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  @@unique([businessId, clientId])
}

enum SaleStatus {
  /// Venta abierta: se agendo y hay anticipo, pero el servicio no se ha dado.
  /// Queda fuera de reportes, nomina y comisiones, que filtran por COMPLETED:
  /// la comision se gana cuando se hace el trabajo, no cuando se aparta.
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

//////////////////////
// 💰 VENTAS (El corazón del POS)
//////////////////////

model Sale {
  id            String     @id @default(uuid())
  businessId    String
  folio         Int        @default(autoincrement()) // Ticket #1, #2...
  clientId      String? // Opcional para "Público General"
  employeeId    String // Quién atendió/vendió
  appointmentId String?    @unique // Opcional: liga la venta a una cita del calendario
  couponId      String?             // Cupón aplicado (opcional)
  subtotal      Float      @default(0)
  discount      Float      @default(0) // Monto descontado por el cupón
  total         Float // Monto final cobrado
  status        SaleStatus @default(COMPLETED)
  notes         String? // Para auditoría: "Se aplicó descuento por retraso"
  mpPaymentId       String?    // ID del pago en MercadoPago (cobros con terminal)
  mpFee             Float?     // Comisión cobrada por MP sobre este pago (incluye IVA)
  mpNetReceived     Float?     // Monto neto que realmente entró a la cuenta (tras comisión+IVA)
  mpTaxes           Float?     // Impuestos retenidos sobre la transacción
  mpReleaseDate     DateTime?  // Fecha en que MP libera el dinero a la cuenta
  promotionDiscount Float?     // Descuento total aplicado por promociones automáticas
  createdAt     DateTime   @default(now()) // LA HORA REAL DEL COBRO
  updatedAt     DateTime   @updatedAt
  active        Boolean    @default(true) // <-- NUEVO

  business    Business     @relation(fields: [businessId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  coupon      Coupon?      @relation(fields: [couponId], references: [id])

  items    SaleItem[]
  payments Payment[]

  @@index([businessId, createdAt])
  @@index([employeeId, createdAt])
  @@index([mpPaymentId])
}


model SaleItem {
  id            String  @id @default(uuid())
  saleId        String
  serviceId     String?
  productId     String?
  description   String // Nombre del servicio o producto al momento de vender (Snapshot)
  price         Float // Precio al que se vendió (histórico)
  quantity      Int     @default(1)
  couponCovered Boolean @default(false) // true = este ítem fue cubierto por una cortesía
  active        Boolean @default(true)

  sale    Sale     @relation(fields: [saleId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

//////////////////////
// 🎫 CUPONES
//////////////////////

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponLimitType {
  QUANTITY
  DATE
  BOTH
}

enum CouponCategory {
  DISCOUNT
  COURTESY
}

model Coupon {
  id          String          @id @default(uuid())
  businessId  String
  code        String
  name        String
  category    CouponCategory  @default(DISCOUNT)
  type        CouponType      @default(PERCENTAGE)
  value       Float           @default(0)
  minPurchase Float           @default(0)
  serviceNote String?         // Para COURTESY: servicios incluidos
  limitType   CouponLimitType
  totalStock  Int             @default(1)
  usedCount   Int             @default(0)
  startDate   DateTime
  endDate     DateTime
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  couponKind  String          @default("GENERIC") // "GENERIC" | "FOLIADO"

  business    Business        @relation(fields: [businessId], references: [id])
  sales       Sale[]
  tokens      CouponToken[]

  @@unique([businessId, code])
}

model CouponToken {
  id        String    @id @default(uuid())
  couponId  String
  usedAt    DateTime?           // null = disponible, fecha = canjeado
  saleId    String?   @unique   // Venta que lo canjeó

  createdAt DateTime  @default(now())

  coupon    Coupon    @relation(fields: [couponId], references: [id])
}

//////////////////////
// 🎯 PROMOCIONES
//////////////////////

model Promotion {
  id            String    @id @default(uuid())
  businessId    String
  name          String
  type          String    // "SERVICE_DISCOUNT" | "BUY_X_GET_Y" | "COMBO"
  discountType  String?   // "PERCENTAGE" | "FIXED"
  discountValue Float?
  buyQuantity   Int       @default(2)   // BUY_X_GET_Y: tamaño del grupo
  getQuantity   Int       @default(1)   // BUY_X_GET_Y: cuántos son gratis
  startDate     DateTime
  endDate       DateTime
  usedCount     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  business  Business          @relation(fields: [businessId], references: [id])
  services  PromotionService[]

  @@index([businessId, active])
}

model PromotionService {
  id          String    @id @default(uuid())
  promotionId String
  serviceId   String
  role        String    @default("PRIMARY") // "PRIMARY" | "SECONDARY" (COMBO)

  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id])

  @@unique([promotionId, serviceId])
}

model CashClose {
  id          String   @id @default(uuid())
  businessId  String
  userId      String // Quién hizo el corte
  openingDate DateTime
  closingDate DateTime @default(now())

  cashExpected Float // Lo que el sistema dice
  cashActual   Float // Lo que el usuario contó físicamente
  difference   Float // Faltante o sobrante

  notes String?

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, closingDate])
}

/// La sesion queda atada al salon en el que se inicio.
///
/// Guardar aqui businessId y role evita consultar la membresia en cada
/// request del middleware, y hace explicito lo que ya ocurria: entrar por el
/// subdominio de otro salon es una sesion distinta.
model Session {
  id         String   @id
  businessId String?
  role       String?
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

//////////////////////
// 💰 BONOS DE NOMINA
//////////////////////

/// De donde sale el numero de un bono.
enum BonusType {
  /// Sin retardos ni faltas por encima de lo tolerado.
  PUNCTUALITY
  /// Cantidad de servicios realizados en el periodo.
  SERVICES
  /// Dinero vendido en el periodo.
  REVENUE
  /// Clientes distintos atendidos en el periodo.
  CLIENTS
  /// No se calcula: alguien decide si se otorga. Presentacion, atencion.
  MANUAL
}

/// El catalogo de bonos de un salon. Se crea, edita y borra por salon; nunca
/// se comparte entre salones.
model BonusRule {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  description String?
  type        BonusType

  /// Monto fijo en pesos. Los porcentajes y los escalones se pueden agregar
  /// despues sin tocar los bonos ya creados.
  amount      Float     @default(0)

  /// La meta a alcanzar: servicios, pesos vendidos o clientes. Vacia en los
  /// bonos de puntualidad y en los manuales.
  goal        Float?

  /// Cuantos retardos y faltas se toleran sin perder el bono de puntualidad.
  /// Las faltas justificadas no cuentan.
  maxLates    Int       @default(0)
  maxAbsences Int       @default(0)

  /// Apagar un bono en vez de borrarlo, para no alterar periodos ya pagados.
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  awards      BonusAward[]

  @@index([businessId, active])
}

/// Lo que se decide a mano sobre un bono en un periodo: los manuales
/// -presentacion, atencion- y las excepciones sobre los automaticos.
model BonusAward {
  id          String   @id @default(uuid())
  businessId  String
  employeeId  String
  ruleId      String

  /// El periodo al que pertenece, con el dia de corte del salon.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  granted     Boolean  @default(true)
  /// Monto distinto al del catalogo, para el caso excepcional.
  amount      Float?
  /// El porque. Es lo que se le ensena a la empleada cuando pregunta.
  note        String?

  grantedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business  @relation(fields: [businessId], references: [id])
  employee    Employee  @relation("BonusAwardEmployee", fields: [employeeId], references: [id])
  rule        BonusRule @relation(fields: [ruleId], references: [id])
  grantedBy   Employee? @relation("BonusAwardGrantedBy", fields: [grantedById], references: [id])

  /// Un bono por persona por periodo.
  @@unique([businessId, employeeId, ruleId, periodStart])
  @@index([businessId, periodStart])
}

//////////////////////
// 🔒 NOMINA CERRADA
//////////////////////

/// Una semana de nomina ya pagada.
///
/// Mientras un periodo no esta aqui, la nomina se recalcula cada vez que se
/// abre: si despues se cancela o edita una venta vieja, lo que ya se pago
/// cambia solo y no queda registro. Cerrar guarda el detalle tal como se
/// pago, y a partir de entonces la pantalla muestra lo guardado.
model PayrollPeriod {
  id          String   @id @default(uuid())
  businessId  String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  closedAt    DateTime @default(now())
  closedById  String?
  /// Lo que sumo la nomina completa al cerrarla.
  total       Float    @default(0)

  business    Business      @relation(fields: [businessId], references: [id])
  closedBy    Employee?     @relation("PayrollClosedBy", fields: [closedById], references: [id])
  lines       PayrollLine[]

  @@unique([businessId, periodStart])
  @@index([businessId, periodStart])
}

/// Lo que se le pago a una persona en un periodo cerrado. Los nombres y
/// porcentajes van copiados, no referidos: cambiar el sueldo de alguien no
/// puede reescribir lo que ya se le pago.
model PayrollLine {
  id                   String @id @default(uuid())
  periodId             String
  employeeId           String
  employeeName         String
  role                 String
  baseSalary           Float
  commissionPercentage Float
  /// La venta en servicios sobre la que se calculo la comision.
  salesBase            Float
  commissionPay        Float
  bonusTotal           Float
  totalPay             Float

  period   PayrollPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee           @relation(fields: [employeeId], references: [id])
  bonuses  PayrollLineBonus[]

  @@index([periodId])
}

/// Cada bono como quedo al cerrar, ganado o no, con su motivo.
model PayrollLineBonus {
  id      String  @id @default(uuid())
  lineId  String
  ruleId  String?
  name    String
  amount  Float
  granted Boolean
  reason  String?
  manual  Boolean @default(false)

  line PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
}
